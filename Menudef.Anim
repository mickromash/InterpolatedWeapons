	3, "$MRIntW_GlovesColor3"//Tan (Classic)
	4, "$MRIntW_GlovesColor4"//Tan (Classic)
	5, "$MRIntW_GlovesColor5"//Tan (Classic)
	6, "$MRIntW_GlovesColor6"//Tan (Classic)
	7, "$MRIntW_GlovesColor7"//Custom
}

