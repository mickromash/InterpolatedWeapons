OptionMenu "MRIntWeaps_ParticlesMenu"
{
	Class MRIntWeaps_OptionMenu
	Animated
	AnimatedTransition
	Title "$MRIntWeaps_ParticlesMenu"
	StaticText ""
	Option "$MRIntW_Casings", "MRIntW_Casings", "MRIntW_CasingsValues"
	Slider "$MRIntW_CasingsRandom", "MRIntW_CasingsRandom", .5, 3, .1, 2, "MRIntW_Casings"
	Slider "$MRIntW_CasingsVolume", "MRIntW_CasingsVolume", 0, 2, .1, 2, "MRIntW_Casings"
	Slider "$MRIntW_CasingsAmount", "MRIntW_CasingsAmount", 1, 3000, 50, 0, "MRIntW_Casings"
	Option "$MRIntW_CasingsClusteringReduce", "MRIntW_CasingsClusteringReduce", "YesNo", "MRIntW_Casings"
	Option "$MRIntW_CasingsLowRes", "MRIntW_CasingsLowRes", "YesNo", "MRIntW_Casings"
	StaticText ""
	Option "$MRIntW_Smoke", "MRIntW_Smoke", "YesNo"
	Option "$MRIntW_FlowingSmoke", "MRIntW_FlowingSmoke", "YesNo"
	Slider "$MRIntW_FlowingSmokeLength", "MRIntW_FlowingSmokeLength", .1, 5, .25, 2, "MRIntW_FlowingSmoke"
	Slider "$MRIntW_FlowingSmokeAlpha", "MRIntW_FlowingSmokeAlpha", .025, 1, .025, 2, "MRIntW_FlowingSmoke"
	Slider "$MRIntW_FlowingSmokeMaxTime", "MRIntW_FlowingSmokeMaxTime", .1, 2, .1, 2, "MRIntW_FlowingSmoke"
	Slider "$MRIntW_FlowingSmokePrecision", "MRIntW_FlowingSmokePrecision", .1, 1.5, .05, 2, "MRIntW_FlowingSmoke"
	Option "$MRIntW_FlowingSmokeBioTexture", "MRIntW_FlowingSmokeBioTexture", "YesNo", "MRIntW_FlowingSmoke"
	Option "$MRIntW_LongTermSmoke", "MRIntW_LongTermSmoke", "YesNo"
	StaticText ""
	StaticText ""
	Option "$MRIntW_ParticleTexture", "MRIntW_ParticleTexture", "MRIntW_ParticleTextureValues"
	Option "$MRIntW_ParticleSmokeTexture", "MRIntW_ParticleSmokeTexture", "MRIntW_ParticleTextureValues"
	StaticText ""
	Option "$MRIntW_PlayerParticles", "MRIntW_PlayerParticles", "YesNo"
	Slider "$MRIntW_PlayerParticlesAmount", "MRIntW_PlayerParticlesAmount", 0, 5, .25, 2
	SubMenu "$MRIntWeaps_PlayerParticlesMenu", "MRIntWeaps_PlayerParticlesMenu"
	StaticText ""
	Option "$MRIntW_MonsterParticles", "MRIntW_MonsterParticles", "YesNo"
	Slider "$MRIntW_MonsterParticlesAmount", "MRIntW_MonsterParticlesAmount", 0, 5, .25, 2
	SubMenu "$MRIntWeaps_MonsterParticlesMenu", "MRIntWeaps_MonsterParticlesMenu"
	Option "$MRIntW_MonsterParticleCustom", "MRIntW_MonsterParticleCustom", "YesNo", "MRIntW_MonsterParticles"
	StaticText ""
	Option "$MRIntW_ParticleFlies", "MRIntW_ParticleFlies", "YesNo"
	Slider "$MRIntW_ParticleFliesVolume", "MRIntW_ParticleFliesVolume", 0, 1, .05, 2, "MRIntW_ParticleFlies"
	StaticText ""
	Option "$MRIntW_AltLightnings", "MRIntW_AltLightnings", "YesNo"
	StaticText ""
	Option "$MRIntW_DecorationParticles", "MRIntW_DecorationParticles", "YesNo"
	Slider "$MRIntW_DecorationParticlesAmount", "MRIntW_DecorationParticlesAmount", 0, 5, .25, 2
	SubMenu "$MRIntWeaps_DecorationParticlesMenu", "MRIntWeaps_DecorationParticlesMenu"
	StaticText ""
	Option "$MRIntW_TeleportParticles", "MRIntW_TeleportParticles", "YesNo"
	Option "$MRIntW_TeleportParticlesStyle", "MRIntW_TeleportParticlesStyle", "MRIntW_TeleportParticlesStyleValues", "MRIntW_TeleportParticles"
	Option "$MRIntW_TeleportParticlesStyleMonsters", "MRIntW_TeleportParticlesStyleMonsters", "MRIntW_TeleportParticlesStyleValues", "MRIntW_TeleportParticles"
	StaticText ""
	Option "$MRIntW_RespawnParticles", "MRIntW_RespawnParticles", "MRIntW_RespawnParticlesValues"
	StaticText ""
	StaticText ""
	Command "$MRIntW_ApplyParticles", "MRIntW_ApplyParticles"
}

