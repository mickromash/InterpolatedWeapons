	1, "$MRIntW_TeleportParticlesStyle1"
	2, "$MRIntW_TeleportParticlesStyle2"
	3, "$MRIntW_TeleportParticlesStyle3"
	4, "$MRIntW_TeleportParticlesStyle4"
	5, "$MRIntW_TeleportParticlesStyle5"
	6, "$MRIntW_TeleportParticlesStyle6"
