	Values
*/


OptionValue "MRIntW_CasingsValues"
{
	0, "$MRIntW_Casings0"//None
	1, "$MRIntW_Casings1"//Visual only
	2, "$MRIntW_Casings2"//Visual + physical
}

OptionValue "MRIntW_ParticleTextureValues"
{
	-1, "$MRIntW_ParticleTextureDef"
	0, "$MRIntW_ParticleTexture0"
	1, "$MRIntW_ParticleTexture1"
	2, "$MRIntW_ParticleTexture2"
}

OptionValue "MRIntW_TeleportParticlesStyleValues"
{
