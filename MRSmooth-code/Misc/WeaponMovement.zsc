/*
	Misc. weapon and player every-tic actions
*/

Extend Class MRIntWeaps_Fist
{
	Weapon Weap;
	Bool Allowed, OfstAdd;
	PSPrite PSP;
	
	Void DoMisc()
	{
		Weap = Owner.Player.ReadyWeapon;
		if(!Weap||!Owner.Player.FindPSprite(PSP_WEAPON))Return;
		PSP = Owner.Player.GetPSprite(PSP_WEAPON);
		Allowed = (!InStateSequence(PSP.curState, Weap.GetDownState()) && !InStateSequence(PSP.CurState, Weap.FindState("Select")));
		
		OfstAdd = false;
		
		Weap.BobStyle = MRIntW_BobStyle;
		Weap.BobRangeX = MRIntW_BobRangeX;
		Weap.BobRangeY = MRIntW_BobRangeY;
		
		if(MRIntW_VanillaFireBob)DoVanillaFiringBob();
		
		if(MRIntW_BaseOffset)DoBaseOffset();
		
		if(MRIntW_DamageShake)DoDamageShake();
		
		if(LowerGun || RunKey>0 || MRIntW_RunKey>0)DoGunLower();
		
		if(MRIntW_Bounce)DoBounce();
		
		if(MRIntW_WeaponSway)DoSway(MRIntW_WeaponSwayStyle);
	}
	
	Vector2 FireBob, OldFireBob;
	Double BobInter;
	Void DoVanillaFiringBob()
	{
		if(
			InStateSequence(PSP.CurState, Weap.FindState("Fire"))||
			InStateSequence(PSP.CurState, Weap.FindState("Select"))||
			InStateSequence(PSP.CurState, Weap.FindState("Deselect"))
		){
			PSP.X = FireBob.X;
			if(Owner.Player.FindPSprite(2) && Owner.Player.FindPSprite(2).bMirror)PSP.X = -FireBob.X;
			if(InStateSequence(PSP.CurState, Weap.FindState("Fire")))PSP.Y = 32+FireBob.Y;
			
			PSP.OldX = PSP.X;
			if(InStateSequence(PSP.CurState, Weap.FindState("Fire")))PSP.OldY = PSP.Y;
			
			OldFireBob = FireBob;
			BobInter = 1;
			
			OfstAdd = true;
		}
		else {
			FireBob = PlayerPawn(Owner).BobWeapon(2);
			if(BobInter>0 && OldFireBob.Length()>0){
				if(InStateSequence(PSP.CurState, Weap.FindState("Ready"))){
					PSP.X = -FireBob.X*BobInter;
					PSP.X += OldFireBob.X*BobInter;
					if(Owner.Player.FindPSprite(2) && Owner.Player.FindPSprite(2).bMirror){
						PSP.X = FireBob.X*BobInter;
						PSP.X -= OldFireBob.X*BobInter;
					}
					PSP.Y = -FireBob.Y*BobInter+32;
					PSP.Y += OldFireBob.Y*BobInter;
					
					if(BobInter==1){
						PSP.OldX = PSP.X;
						PSP.OldY = PSP.Y;
					}
					
					BobInter *= .6;
					if(BobInter<.1){
						OldFireBob = (0,0);
						BobInter = 0;
					}
					
					OfstAdd = true;
				}
				else OldFireBob = (0,0);
			}
			else BobInter = 0;
		}
	}
	
	Vector2 BaseOffset;
	Void DoBaseOffset()
	{
		if(!Allowed){
			BaseOffset *= 0;
			Return;
		}
		
		BaseOffset.X += (MRIntW_BaseOffsetX - BaseOffset.X)*.2;
		BaseOffset.Y += (MRIntW_BaseOffsetY - BaseOffset.Y)*.2;
		
		if(OfstAdd){
			PSP.X += BaseOffset.X;
			PSP.OldX = PSP.X;
			if(Allowed){
				PSP.Y += BaseOffset.Y;
				PSP.OldY = PSP.Y;
			}
		}
		else {
			PSP.X = BaseOffset.X;
			if(Allowed)PSP.Y = 32+BaseOffset.Y;
			OfstAdd = true;
		}
	}
	
	int DamageShake, PlrLastHealth;
	Void DoDamageShake()
	{
		if(DamageShake>0){
			Double Shake = DamageShake;
			Shake *= .1;
			
			if(!OfstAdd){
				PSP.X = GetAge()%2==0?Shake:-Shake;
				if(Allowed)PSP.Y = 32+Shake*CFRandom(0, 1);
				OfstAdd = true;
			}
			else {
				PSP.X += GetAge()%2==0?Shake:-Shake;
				if(Allowed)PSP.Y += Shake*CFRandom(0, 1);
			}
			
			DamageShake -= 4;
			if(DamageShake<0)DamageShake = 0;
		}
		
		if(Owner.Health<PlrLastHealth){
			DamageShake = PlrLastHealth - Max(0, Owner.Health);
		}
		
		PlrLastHealth = Max(0, Owner.Health);
	}
	
	Bool LowerGun;
	Double RunKey;
	Void DoGunLower()
	{
		if(Allowed){
			Bool Invert = MRIntW_RunKey>1;
			Bool Pressing = (Owner.Player.Cmd.Buttons&BT_SPEED) || LowerGun;
			if(LowerGun && Owner.Player.Cmd.Buttons&BT_SPEED)Pressing = !Pressing;
			
			if(Pressing != Invert){
				if(RunKey<1)RunKey += Max(.05, (1-RunKey)*.1);
			}
			else {
				if(RunKey>.01)RunKey *= .8;
				else RunKey = 0;
			}
			
			if(!OfstAdd)PSP.Y = 32+RunKey*26;
			else {
				PSP.Y += RunKey*26;
				PSP.OldY = PSP.Y;
			}
			OfstAdd = true;
		}
		else RunKey = 0;
	}
	
	Double CurBounce, BounceStrength;
	Bool Bouncing, Landed;
	Void DoBounce()
	{
		Bool Clear = MRIntW_Bounce>1;//Weapon only goes down
		
		Bouncing = false;
		
		if(Owner.Pos.Z > Owner.FloorZ){
			BounceStrength = Owner.Vel.Z;//Move weapon based on vertical velocity (going down - move up, going up - move down)
			CurBounce += (Clear?Max(0, (abs(BounceStrength) + CurBounce))*.4 : (BounceStrength - CurBounce)*.5);
			if(Clear) CurBounce = Min(40, CurBounce);
			else CurBounce = Clamp(CurBounce, -abs(Weap.FloatSpeed*6.5), 20);
			Bouncing = true;
			Landed = true;
		}
		else if(abs(BounceStrength)>0){
			if(Clear && Landed)BounceStrength = -CurBounce;
			
			if(CurBounce<-BounceStrength)CurBounce -= BounceStrength*.5;
			
			else {
				BounceStrength *= .7;
				if(abs(BounceStrength)<.05)BounceStrength = 0;
				CurBounce = -BounceStrength;
			}
			
			Bouncing = true;
			
			if(Landed){//Camera shake on landing
				Landed = false;
				if(abs(CurBounce)>4 && MRIntW_ScreenShake>2)Owner.A_QuakeEx(1*Min(20, abs(CurBounce)),0,0, Clamp(abs(CurBounce)*2, 1, 20), 0, .5, "", QF_RELATIVE|QF_SCALEDOWN|QF_SCALEUP|QF_WAVE, 2,0,0, rollIntensity: .1*Min(30, abs(CurBounce)), rollwave: 2);
			}
		}
		
		if(Bouncing && Allowed){
			if(Clear){
				if(!OfstAdd)PSP.Y = 32 + CurBounce;
				else {
					PSP.Y += CurBounce;
					PSP.OldY = PSP.Y;
				}
				OfstAdd = true;
			}
			else {
				if(!OfstAdd)PSP.Y = 32 + CurBounce*.5;
				else {
					PSP.Y += CurBounce*.5;
					PSP.OldY = PSP.Y;
				}
				OfstAdd = true;
			}
		}
	}
	
	Vector2 CurSway, Sway;
	int GoingY;
	Float GoingX;
	Void DoSway(int Style)
	{
		Double Target;
		Switch(Style)
		{
			Case 0://Half Life 2
				Target = Sin(Owner.Pitch)*10;//Vecrtical target position
				
				if(InStateSequence(PSP.CurState, weap.FindState("Fire")))Sway.X *= .8;
				
				Sway.Y *= .8;//Temporal vertical position
				
				{
					Vector2 Add = (Owner.Player.Cmd.Yaw, Owner.Player.Cmd.Pitch)*.0025;//Camera rotation to sway
					if(abs(Owner.Pitch)>89)Add.Y -= Owner.Player.Cmd.Pitch*.0025;//Prevent vertical sway glitching when pitch is at max
					
					if((GoingY>0 && Add.X<0)||
						(GoingY<0 && Add.X>0))GoingX = 0;//Reset speed if starting moving in opposite direction
					else if(GoingX<1)GoingX += .3;//Increasing speed
					
					if((Sway.X<0 && Add.X<0) || (Sway.X>0 && Add.X>0))GoingX = Min(1-Max(0, abs(Sway.X)-10)/31, GoingX);//Slowing down as getting close to the max distance
					//Remember last direction
					if(Add.X>0)GoingY = 1;
					else GoingY = -1;
										
					Sway += Add*GoingX;
				}
				
				
				
				Sway.X = Clamp(Sway.X, -40, 40);//Horizontal position
				Sway.Y = Clamp(Sway.Y, -50, 50);
				
				CurSway.Y += (Target - CurSway.Y)*.25;//Vertical position
				
				if(!Allowed){
					Sway.X *= .1;
					CurSway.Y *= .1;
					Sway.Y *= .1;
				}
				
				if(OfstAdd){
					PSP.X += (Sway.X-PSP.X)*.5;
					PSP.OldX = PSP.X;
					if(Allowed){
						PSP.Y += ((CurSway.Y + Sway.Y)-PSP.Y+32)*.5;
						PSP.OldY = PSP.Y = Max(32-abs(Weap.FloatSpeed*6.5), PSP.Y);
					}
				}
				else {
					PSP.X = PSP.X+(Sway.X-PSP.X)*.5;
					if(Allowed)PSP.Y = Max(32-abs(Weap.FloatSpeed*6.5), 32 + CurSway.Y + Sway.Y);
					OfstAdd = true;
				}
				
				if(!Allowed)CurSway.Y = 0;
				
				Break;
			Case 2:
			Case 1://Battlefront 2015
				
				Float Mult = 1;//Speed and direction of sway (+1 is moving away from camera direction, -1 is moving with camera direction)
				Float MultRot = 0;
				
				Switch(Owner.Player.ReadyWeapon.GetClassName()){
					Case 'MRIntWeaps_Fist':
						Mult = -.6;
						if(
							(Owner.Player.FindPSprite(SecndLay) && !InStateSequence(Owner.Player.FindPSprite(SecndLay).CurState, weap.FindState("SecndHandWaitLoop")))
							||(Owner.Player.FindPSprite(MainLay) && !InStateSequence(Owner.Player.FindPSprite(MainLay).CurState, weap.FindState("MainHandWait")))
						)MultRot = 0;
						else MultRot = .3;
						
						Break;
					Case 'MRIntWeaps_Chainsaw':
						Mult = .6;
						if(Owner.Player.FindPSprite(2) && !InStateSequence(Owner.Player.FindPSprite(2).CurState, weap.FindState("SawReady")))MultRot = 0;
						else MultRot = -.15;
						Break;
					Case 'MRIntWeaps_Pistol':
						if(MRIntWeaps_Pistol(Owner.Player.ReadyWeapon).IsRifle){
							Mult = .9;
							if(Owner.Player.FindPSprite(2) && !InStateSequence(Owner.Player.FindPSprite(2).CurState, weap.FindState("RifleWait")))MultRot = 0;
							else MultRot = -.1;
						}
						else {
							Mult = -.5;
							if(Owner.Player.FindPSprite(2) && !InStateSequence(Owner.Player.FindPSprite(2).CurState, weap.FindState("GunWait")))MultRot = 0;
							else MultRot = .2;
						}
						Break;
					Case 'MRIntWeaps_Shotgun':
						if(Owner.Player.FindPSprite(2) && !InStateSequence(Owner.Player.FindPSprite(2).CurState, weap.FindState("GunWait")))MultRot = 0;
						else MultRot = -.1;
					Case 'MRIntWeaps_PlasmaRifle':
						Mult = .8;
						Break;
					Case 'MRIntWeaps_SuperShotgun':
						Mult = 1;
						if(Owner.Player.FindPSprite(2) && !InStateSequence(Owner.Player.FindPSprite(2).CurState, weap.FindState("GunWait")))MultRot = 0;
						else MultRot = -.11;
						Break;
					Case 'MRIntWeaps_Chaingun':
						Mult = .4;
						Break;
					Case 'MRIntWeaps_RocketLauncher':
						Mult = .5;
						if(Owner.Player.FindPSprite(2) && !InStateSequence(Owner.Player.FindPSprite(2).CurState, weap.FindState("GunWait")))MultRot = 0;
						else MultRot = -.1;
						Break;
					Case 'MRIntWeaps_BFG9000':
						Mult = .1;
						Break;
				}
				if(Style==2)MultRot *= 2;
			
				//Y
				Target = -Sin(Owner.Pitch)*20;//Where to move

				Sway.Y += (Target - CurSway.Y)*.1;//Velocity
				Sway.Y = Clamp(Sway.Y, -5, 5);
				
				if((Sway.Y<0 && CurSway.Y<Target)||
					(Sway.Y>0 && CurSway.Y>Target))Sway.Y *= .2*abs(Mult);//Wobbling
				
				CurSway.Y += Sway.Y;//Current offset
				
				//X
				Target = Owner.Player.Cmd.Yaw*.01*Mult;//Where to move
				
				Float Add = (Target - CurSway.X);//Speed is based on how far the current position is from the target position
				
				if(Target==0){//If camera is not moving
					if(GoingX<1)GoingX += .1*abs(Mult*.5);//Increasing speed
					Add *= GoingX*.25;
				}
				else {//Camera is moving
					Add *= .1;//Sway speed is lower when camera is moving
					GoingX = 0;//Speed will be set to zero when camera will stop moving
				}
				Sway.X += Add;
				
				if((Sway.X<0 && CurSway.X<Target)||
					(Sway.X>0 && CurSway.X>Target))Sway.X *= .05;//Wobbling
				
				CurSway.X += Sway.X;
				
				if(!Allowed){
					CurSway.X *= .1;
					CurSway.Y *= .1;
				}
				
				if(OfstAdd){
					PSP.X += (CurSway.X - PSP.X)*.5;
					PSP.OldX = PSP.X;
					if(Allowed){
						PSP.Y += (CurSway.Y - PSP.Y +32)*.5;
						PSP.OldY = PSP.Y = Max(32-abs(Weap.FloatSpeed*6.5), PSP.Y);
					}
				}
				else {
					PSP.OldX = PSP.X = PSP.X+(CurSway.X - PSP.X)*.5;
					if(Allowed)PSP.Y = Max(32-abs(Weap.FloatSpeed*6.5), 32 + CurSway.Y);
					OfstAdd = true;
				}
				if(!Allowed)CurSway.Y = 0;
				
				
				if(MultRot!=0 && Owner.Player.FindPSprite(2)){
					Float OldRot = Owner.Player.GetPSprite(2).Rotation;
					Owner.Player.GetPSprite(2).Rotation += (-(PSP.X-BaseOffset.X)*MultRot-Owner.Player.GetPSprite(2).Rotation)*.5;
					if(MRIntWeaps_Chainsaw(Owner.Player.ReadyWeapon)){
						Let Saw = MRIntWeaps_Chainsaw(Owner.Player.ReadyWeapon);
						For(int i=Saw.LayBlood;i<Saw.LayBlood+40;i++){
							if(Owner.Player.FindPSprite(i)){
								Owner.Player.FindPSprite(i).Rotation = Owner.Player.GetPSprite(2).Rotation;
								Owner.Player.FindPSprite(i).X = Owner.Player.GetPSprite(2).X;
								Owner.Player.FindPSprite(i).Y = Owner.Player.GetPSprite(2).Y;
							}
						}
					}
					if((MultRot == .3 || MultRot == .6) && Owner.Player.FindPSprite(MainLay))Owner.Player.GetPSprite(MainLay).Rotation += (-(PSP.X-BaseOffset.X)*MultRot-Owner.Player.GetPSprite(MainLay).Rotation)*.5;
					else if(MultRot==.11 || MultRot==.22){
						if(Owner.Player.FindPSprite(1500))Owner.Player.GetPSprite(1500).Rotation = Owner.Player.GetPSprite(2).Rotation;
					}
				}
				
				Break;
		}
	}
	
	
	
	
	Clearscope Static Double GetBobZ(Weapon Weap, Double Center = .5)
	{
		PlayerPawn Plr = PlayerPawn(Weap.Owner);
		
		Double Range = MRIntW_BobRangeZ;
		int bobstyle = Weap.BobStyle;
		double angle = (Weap.BobSpeed*128 * Plr.player.GetWBobSpeed() * 35 /	TICRATE*(Level.maptime)) * (360. / 8192.);

		// [RH] Smooth transitions between bobbing and not-bobbing frames.
		// This also fixes the bug where you can "stick" a weapon off-center by
		// shooting it when it's at the peak of its swing.
		Double R;

		// The weapon bobbing intensity while firing can be adjusted by the player.
		double BobIntensity = ((Plr.player.WeaponState & WF_WEAPONBOBBING) ? 1. : Plr.player.GetWBobFire())*.01;

		if (Plr.curbob != 0)
		{
			double bobVal = Plr.player.bob;
			
			bobVal = Plr.prevBob;
			//[SP] Added in decorate player.viewbob checks
			double bob = (bobVal * BobIntensity * Range * Plr.ViewBob);
			switch (bobstyle)
			{
			case Bob_Normal:
				R = Bob * (Center - abs(Sin(angle)));
				break;

			case Bob_Inverse:
				R = bob * (Center - abs(sin(angle)));
				break;

			case Bob_Alpha:
				R = bob * (Center - abs(sin(angle)));
				break;

			case Bob_InverseAlpha:
				R = bob * (Center - abs(sin(angle)));
				break;

			case Bob_Smooth:
				R = 0.5f * (bob * (Center - (cos(angle * 2))));
				break;

			case Bob_InverseSmooth:
				R = 0.5f * (bob * (Center + (cos(angle * 2))));
			}
		}
		else
		{
			r = 0;
		}
		
		Return R;
	}
}