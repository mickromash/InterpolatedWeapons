		Hell:
			#### # 1 {
				Player.GetPSprite(SecndLay).Y = -50+(Player.GetPSprite(SecndLay).Y+50)*(1-invoker.IdleState);
				Player.GetPSprite(MainLay).Y = 20+(Player.GetPSprite(MainLay).Y-20)*(1-invoker.IdleState);
				if(Player.GetPSprite(MainLay).Y < 19.5*invoker.IdleState)Player.SetPsprite(SecndLay, Player.GetPSprite(SecndLay).CurState);
			}
			#### # 1;
			#### # 1 {
				Player.GetPSprite(MainLay).Y = -50+(Player.GetPSprite(MainLay).Y+50)*(1-invoker.IdleState);
				Player.GetPSprite(SecndLay).Y = 20+(Player.GetPSprite(SecndLay).Y-20)*(1-invoker.IdleState);
				if(Player.GetPSprite(SecndLay).Y < 19.5*invoker.IdleState)Player.SetPsprite(SecndLay, Player.GetPSprite(SecndLay).CurState);
			}
			#### # 1;
			#### # 0 {invoker.IdleState *= .9;}
			#### # 0 A_JumpIf(invoker.IdleState<.001, 1);
			Goto Hell;
			#### ### 1 {
				Player.GetPSprite(MainLay).Y *= .6;
				Player.GetPSprite(SecndLay).Y *= .6;
			}
			#### ###################### 1 {
				A_OverlayOffseT(SecndLay, 0, 5, WOF_ADD);
				A_OverlayOffseT(MainLay, 0, 5, WOF_ADD);
			}
			#### # 1 {
				A_OverlayOffseT(SecndLay, 0, 70, WOF_INTERPOLATE);
				A_OverlayOffseT(MainLay, 0, 70, WOF_INTERPOLATE);
			}
			TNT1 A 7 A_OverlayFlags(OverlayId(), PSPF_INTERPOLATE, false);
			Goto SecndHandRaise;
			
		MainHandCoolIdle666:
			MRD1 G 1;
			Wait;
	}
