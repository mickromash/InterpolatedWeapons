				A_OverlayFlags(OverlayId()-4, PSPF_INTERPOLATE, !Player.GetPSprite(OverlayId()-4).FirstTic);
				A_CopyMaster(OverlayId()-6, OverlayId()-5, (75, 165) + (invoker.FigOffset[OverlayId()>SecndLay+6?1:0].X, invoker.FigOffset[OverlayId()>SecndLay+6?1:0].Y*.5), -90);
				A_CopyMaster(OverlayId()-6, OverlayId()-4);
				
				if(OverlayId()-6==SecndLay && invoker.LineTarg && invoker.LineTarg.Health<invoker.TargLastHP)Player.SetPsprite(OverlayId(), invoker.FindState("HandInfightPain"));
				if(OverlayId()-6!=SecndLay && invoker.LineTarg && invoker.LineTarg.Target && invoker.LineTarg.Target.Health<invoker.TargTargLastHP)Player.SetPsprite(OverlayId(), invoker.FindState("HandInfightPain"));
