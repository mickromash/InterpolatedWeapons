				A_Overlay(MainLay+2, "MainHandInfight");
				Player.GetPSprite(MainLay+2).X = Player.GetPSprite(SecndLay).X;
				Player.GetPSprite(MainLay+2).Y = Player.GetPSprite(SecndLay).Y;
				Player.GetPSprite(MainLay+2).OldX = Player.GetPSprite(SecndLay).OldX;
				Player.GetPSprite(MainLay+2).OldY = Player.GetPSprite(SecndLay).OldY;
				A_Overlay(MainLay+4, "SecndHandInfightOver");
				A_Overlay(MainLay+3, "InfightActor");
			}
			#### ########### 1 {
				Player.GetPSprite(SecndLay).Y = -40+(Player.GetPSprite(SecndLay).Y+40)*.8;
				Player.GetPSprite(MainLay+2).Y = -40+(Player.GetPSprite(SecndLay).Y+40)*.8;
			}
			#### # 1 {
				A_OverlayOffset(SecndLay, 0, -40, WOF_INTERPOLATE);
				A_OverlayOffset(MainLay+2, 0, -40, WOF_INTERPOLATE);
			}
		SecndHandInfightLoop:
			#### # 1{
				if(!invoker.LineTarg || invoker.LineTarg.Health<1 || invoker.NoTargDelay>35*8)
				{
					if(invoker.LineTarg && invoker.LineTarg.Health<1)Player.SetPsprite(OverlayId()+6, invoker.FindState("HandInfightDeath"));
					Player.SetPsprite(OverlayId(), invoker.FindState("SecndHandInfightEnd"));
				}
				
				if(!Player.FindPSprite(OverlayId()+6) && Player.GetPSprite(OverlayId()).Frame != 10 && 
					invoker.LineTarg.Target && invoker.LineTarg.Target != Self && Player.FindPSprite(MainLay+2) &&
					(InStateSequence(invoker.LineTarg.CurState, invoker.LineTarg.FindState("Missile"))||
					InStateSequence(invoker.LineTarg.CurState, invoker.LineTarg.FindState("Melee")))
				){
					Player.SetPsprite(OverlayId()+6, invoker.FindState("HandInfightAttack"));
					if(invoker.Leading==0)invoker.Leading = 1;
				}
				if(!Player.FindPSprite(OverlayId()+6) &&invoker.TargLastHP > invoker.LineTarg.Health)
				{
					Player.SetPsprite(OverlayId()+6, invoker.FindState("HandInfightPain"));
				}
				if(!Player.FindPSprite(OverlayId()+6) && invoker.Attacking < 0)
				{
					Player.SetPsprite(OverlayId()+6, invoker.FindState("HandInfightDodge"));
				}
				
				if(!Player.FindPSprite(MainLay+2) && invoker.LineTarg.Target && invoker.LineTarg.Target != Self){
					A_Overlay(MainLay+2, "MainHandInfight");
					Player.GetPSprite(MainLay+2).X = Player.GetPSprite(SecndLay).X;
					Player.GetPSprite(MainLay+2).Y = 100;
					Player.GetPSprite(MainLay+2).OldX = Player.GetPSprite(SecndLay).OldX;
					Player.GetPSprite(MainLay+2).OldY = Player.GetPSprite(MainLay+2).OldY;
					A_Overlay(MainLay+4, "SecndHandInfightOver");
					A_Overlay(MainLay+3, "InfightActor");
					A_Overlay(MainLay+2+6, "HandInfightRaise");
					invoker.NoTargDelay = 0;
					
					Return;
				}
				
				if(!Player.FindPSprite(MainLay+2)){
					invoker.NoTargDelay++;
					Return;
				}
				
				if(!invoker.LineTarg.Target || invoker.LineTarg.Target.Health<1){
					if(!Player.FindPSprite(MainLay+2+6) || !InStateSequence(Player.GetPSprite(MainLay+2+6).CurState, invoker.FindState("HandInfightDeath"))){
						Player.SetPsprite(MainLay+2+6, invoker.FindState("HandInfightDeath"));
						//if(CRandom(0,3)==1 && (!Player.FindPSprite(SecndLay+6) || !InStateSequence(Player.GetPSprite(SecndLay+6).CurState, invoker.FindState("HandInfightPraise"))))Player.SetPsprite(SecndLay+6, invoker.FindState("HandInfightPraise"));
					}
					Return;
				}
				
				if(!Player.FindPSprite(MainLay+2+6) && Player.GetPSprite(MainLay+2).Frame != 10 && invoker.LineTarg.Target &&
					invoker.LineTarg.Target.Target == invoker.LineTarg &&(
					InStateSequence(invoker.LineTarg.Target.CurState, invoker.LineTarg.Target.FindState("Missile"))||
					InStateSequence(invoker.LineTarg.Target.CurState, invoker.LineTarg.Target.FindState("Melee")))
				){
					Player.SetPsprite(MainLay+2+6, invoker.FindState("HandInfightAttack"));
					if(invoker.Leading == 0)invoker.Leading = -1;
				}
				if(!Player.FindPSprite(MainLay+2+6) && invoker.TargTargLastHP > invoker.LineTarg.Target.Health)
				{
					Player.SetPsprite(MainLay+2+6, invoker.FindState("HandInfightPain"));
				}
				if(!Player.FindPSprite(MainLay+2+6) && invoker.Attacking > 0)
				{
					Player.SetPsprite(MainLay+2+6, invoker.FindState("HandInfightDodge"));
				}
			}
			Wait;
		SecndHandInfightEnd:
			#### ################################### 1 {
				if(!Player.FindPSprite(OverlayId()+6)){
					A_OverlayOffset(SecndLay, 0, 7, WOF_ADD);
					if(invoker.LineTarg.Health<1)Player.GetPSprite(SecndLay).X = CFRandom(-4, 4)*(GetAge()%2==0?1:-1);
				}
				if(!Player.FindPSprite(MainLay+2+6)){
					A_OverlayOffset(MainLay+2, 0, 7, WOF_ADD);
					if(Player.GetPSprite(MainLay+2).Y < Player.GetPSprite(SecndLay).Y)
						Player.GetPSprite(MainLay+2).Y = Player.GetPSprite(SecndLay).Y+(Player.GetPSprite(MainLay+2).Y-Player.GetPSprite(SecndLay).Y)*.8;
					
					if(invoker.LineTarg.Health>0 || (invoker.LineTarg.Target && invoker.LineTarg.Target.Health<1))Player.GetPSprite(MainLay+2).X = CFRandom(-4, 4)*(GetAge()%2==0?1:-1);
				}
				
				A_CopyMaster(OverlayId(), MainLay, (75, 165) + (invoker.FigOffset[OverlayId()>SecndLay+6?1:0].X, invoker.FigOffset[OverlayId()>SecndLay+6?1:0].Y*.5), -90);
				A_CopyMaster(OverlayId(), MainLay+1);
				
				A_CopyMaster(OverlayId(), MainLay+3, (75, 165) + (invoker.FigOffset[OverlayId()>SecndLay+6?1:0].X, invoker.FigOffset[OverlayId()>SecndLay+6?1:0].Y*.5), -90);
				A_CopyMaster(OverlayId(), MainLay+4);
			}
			#### # 3 {
				A_ClearOverlays(MainLay, MainLay+8);
				A_OverlayScale(OverlayId(), 1, 1);
			}
			Goto SecndHandRaise+1;
			
		HandInfightAttack:
			#### # 0 {
				if(OverlayId()-6==SecndLay && invoker.LineTarg)A_StartSound(invoker.LineTarg.AttackSound, CHAN_VOICE, CHANF_LOCAL, .3, pitch:CFRandom(1.4, 1.45));
				else if(invoker.LineTarg && invoker.LineTarg.Target)A_StartSound(invoker.LineTarg.Target.AttackSound, CHAN_VOICE, CHANF_LOCAL, .3, pitch:CFRandom(1.4, 1.45));
			}
			#### ### 1 {
				A_OverlayOffset(OverlayId()-6, -20, -10, WOF_ADD);
				A_OverlayRotate(OverlayId()-6, 1, WOF_ADD);
				
				A_OverlayFlags(OverlayId()-6, PSPF_INTERPOLATE, !Player.GetPSprite(OverlayId()-6).FirstTic);
				A_OverlayFlags(OverlayId()-4, PSPF_INTERPOLATE, !Player.GetPSprite(OverlayId()-4).FirstTic);
				A_CopyMaster(OverlayId()-6, OverlayId()-5, (75, 165) + (invoker.FigOffset[OverlayId()>SecndLay+6?1:0].X, invoker.FigOffset[OverlayId()>SecndLay+6?1:0].Y*.5), -90);
				A_CopyMaster(OverlayId()-6, OverlayId()-4);
			}
			#### # 1 {
				A_OverlayOffset(OverlayId()-6, -5, -4, WOF_ADD);
				A_OverlayRotate(OverlayId()-6, .5, WOF_ADD);
				A_CopyMaster(OverlayId()-6, OverlayId()-5, (75, 165) + (invoker.FigOffset[OverlayId()>SecndLay+6?1:0].X, invoker.FigOffset[OverlayId()>SecndLay+6?1:0].Y*.5), -90);
				A_CopyMaster(OverlayId()-6, OverlayId()-4);
			}
			#### # 1 A_StartSound("MRIntW/FistSwing", CHAN_AUTO, CHANF_LOCAL, .4, pitch:CFRandom(2, 2.1)*i_timescale);
			#### ## 1 {
				A_OverlayOffset(OverlayId()-6, 90, 10, WOF_ADD);
				
				int Other = OverlayId()-6;
				if(Other==SecndLay)Other = MainLay+2;
				else Other = SecndLay;
				if((invoker.Leading<1 && Other==SecndLay) || (invoker.Leading>-1 && Other!=SecndLay)){
					Player.GetPSprite(OverlayId()-6).Y = Min(Player.GetPSprite(Other).Y, Player.GetPSprite(OverlayId()-6).Y);
					Player.GetPSprite(OverlayId()-6).X = Min(80-Player.GetPSprite(Other).X, Player.GetPSprite(OverlayId()-6).X);
				}
				
