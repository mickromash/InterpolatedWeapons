		SecndHandInfightOver:
			TNT1 A 0;
			#### # 1{
				Player.GetPSprite(OverlayId()).Sprite = Player.GetPSprite(OverlayId()-2).Sprite;
				Player.GetPSprite(OverlayId()).Frame = Player.GetPSprite(OverlayId()-2).Frame - 3;
				Player.GetPSprite(OverlayId()).Translation = invoker.GlovesTrans;
				Player.GetPSprite(OverlayId()).Pivot = Player.GetPSprite(OverlayId()-2).Pivot;
				
				A_CopyMaster(OverlayId()-2);
				Player.GetPSprite(OverlayId()).bMirror = Player.GetPSprite(OverlayId()-2).bMirror;
				Player.GetPSprite(OverlayId()).bFlip = Player.GetPSprite(OverlayId()-2).bFlip;
				A_OverlayFlags(OverlayId(), PSPF_INTERPOLATE, false);
			}
