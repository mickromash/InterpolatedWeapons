		//Playing with demon toys
		MainHandInfightStart:
			#### # 1;
			Wait;
		SecndHandInfight:
			#### # 1 {
				Player.SetPsprite(MainLay, invoker.FindState("MainHandInfightStart"));
				A_OverlayOffset(SecndLay, 0, 5, WOF_ADD);
				A_OverlayOffset(MainLay, 0, 5, WOF_ADD);
			}
			#### #### 1 {
				A_OverlayOffset(SecndLay, 0, 12, WOF_ADD);
				A_OverlayOffset(MainLay, 0, 12, WOF_ADD);
