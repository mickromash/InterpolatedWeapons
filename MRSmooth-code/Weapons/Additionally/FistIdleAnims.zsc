				Player.GetPSprite(Lay).bMirror = Player.GetPSprite(Lay-2).bMirror;
				Player.GetPSprite(Lay).bFlip = Player.GetPSprite(Lay-2).bFlip;
				Player.GetPSprite(Lay).Scale = Player.GetPSprite(Lay-2).Scale;
			}
			Wait;
		
		MainHandInfight:
			PUN1 M 0 {
				A_OverlayFlags(OverlayId(), PSPF_MIRROR|PSPF_FLIP, !GetCVar("MRIntW_RightPunch"));
				A_SetHandsSprite();
				Player.GetPSprite(OverlayId()).Translation = invoker.GlovesTrans;
				A_OverlayPivot(OverlayId(), 1, .2);
				A_OverlayRotate(OverlayId(), 90);
				A_OverlayScale(OverlayId(), 1.2, 1.2);
			}
			#### # 1;
			Wait;
		InfightActor:
			TNT1 A 0 {
				int Lay = OverlayId();
				
				Let Act = invoker.LineTarg;
				if(Lay>MainLay+1)Act = invoker.LineTarg.Target;
				
				if(!Act){
					A_ClearOverlays(Lay, Lay);
					Return;
				}
				Let Stayt = Act.FindState("Spawn");
				TextureId Sprit = Stayt.GetSpriteTexture(0);
				
				int Akhtung;
				While(!Sprit.IsValid() || Stayt.Sprite == GetSpriteIndex("TNT1A0")){
					Stayt = Stayt.NextState;
					Sprit = Stayt.GetSpriteTexture(0);
					Akhtung++;
					
					if(Akhtung>2500)Break;
				}
				
				if(!Sprit.IsValid()){
					A_ClearOverlays(Lay, Lay);
					Return;
				}
				
				Vector2 Scale = Texman.GetScaledSize(Sprit);
				Scale.Y = Texman.CheckRealHeight(Sprit);
				
				Double Fit;
				if(Scale.X*1.25>Scale.Y)Fit = 55/Scale.X;
				else Fit = 45/Scale.Y;
				
				Vector2 Offset = Texman.GetScaledOffset(Sprit)*Fit;
				
				if(Lay>MainLay+1)invoker.FigOffset[1] = Offset;
				else invoker.FigOffset[0] = Offset;
								
				Player.GetPSprite(Lay).Sprite = Stayt.Sprite;
				Player.GetPSprite(Lay).Frame = Stayt.Frame;
				Player.GetPSprite(Lay).Scale *= Fit;
				A_OverlayPivot(Lay, .5, 1);
				
				if(Scale.X*1.25>Scale.Y){
					A_ClearOverlays(Lay+1, Lay+1);
					Player.GetPSprite(Lay-1).Frame = 10;
					Player.GetPSprite(Lay-1).Scale = (1,1);
				}
				
				A_OverlayTranslation(OverlayId(), "MRIntWLowColors");
			}
			#### # 1{
				A_CopyMaster(OverlayId()-1, OverlayId(), (90, 190), -90);
				Player.GetPSprite(OverlayId()).bMirror = Player.GetPSprite(OverlayId()-1).bMirror;
				A_OverlayFlags(OverlayId(), PSPF_INTERPOLATE, false);
			}
			#### # 1{
				int Lay = OverlayId();
				
				if(Player.GetPSprite(Lay-1).Frame==10){
					Let Act = invoker.LineTarg;
					if(Lay>MainLay+1 && Act)Act = invoker.LineTarg.Target;
					
					if(!Act || Act == Self)Return;
					
					if((Act.Target && Act.Target != Self && InStateSequence(Act.CurState, Act.FindState("Missile"))) || 
						((Act == invoker.LineTarg && Act.Health<invoker.TargLastHP) || (Act != invoker.LineTarg && Act.Health<invoker.TargTargLastHP)))
					{
						if(Act.Tics<=1)A_StartSound(Act.AttackSound, CHAN_VOICE, CHANF_MAYBE_LOCAL, .3, pitch:CFRandom(1.4, 1.45));
						else if(((Act == invoker.LineTarg && Act.Health<invoker.TargLastHP) || (Act != invoker.LineTarg && Act.Health<invoker.TargTargLastHP)) && Act.Tics<=1)A_StartSound(Act.PainSound, CHAN_VOICE, CHANF_LOCAL, .3, pitch:CFRandom(1.4, 1.45));
						Player.GetPSprite(Lay).Sprite = Act.Sprite;
						Player.GetPSprite(Lay).Frame = Act.Frame;
						
						Double Height = CFRandom(-42, -32);
						Player.GetPSprite(Lay-1).Y = Height+(Player.GetPSprite(Lay-1).Y-Height)*.9;
						A_OverlayFlags(Lay-1, PSPF_INTERPOLATE, !Player.GetPSprite(Lay-1).FirstTic);
						
						Vector2 Offset = Texman.GetScaledOffset(Act.CurState.GetSpriteTexture(0))*Player.GetPSprite(Lay).Scale.X;
						
						if(Lay>MainLay+1)invoker.FigOffset[1] = Offset;
						else invoker.FigOffset[0] = Offset;
					}
					else {
						Let Stayt = Act.FindState("Spawn");
						
						int Akhtung;
						While(!Stayt.GetSpriteTexture(0).IsValid()){
							Stayt = Stayt.NextState;
							Akhtung++;
							
							if(Akhtung>2500)Break;
						}
						
						if(!Stayt.GetSpriteTexture(0).IsValid())
						{
							Return;
						}
						
						Player.GetPSprite(Lay).Sprite = Stayt.Sprite;
						Player.GetPSprite(Lay).Frame = Stayt.Frame;
						
						Player.GetPSprite(Lay-1).Y = -40+(Player.GetPSprite(Lay-1).Y+40)*.9;
						A_OverlayFlags(Lay-1, PSPF_INTERPOLATE, !Player.GetPSprite(Lay-1).FirstTic);
						
						Vector2 Offset = Texman.GetScaledOffset(Stayt.GetSpriteTexture(0))*Player.GetPSprite(Lay).Scale.X;
						
						if(Lay>MainLay+1)invoker.FigOffset[1] = Offset;
						else invoker.FigOffset[0] = Offset;
					}
				}
								
				A_CopyMaster(Lay-1, Lay, (75, 165) + (invoker.FigOffset[Lay>MainLay+1?1:0].X, invoker.FigOffset[Lay>MainLay+1?1:0].Y*.5), -90);
				Player.GetPSprite(Lay).bMirror = Player.GetPSprite(Lay-1).bMirror;
				
				invoker.TargLastHP = invoker.LineTarg.Health;
				if(invoker.LineTarg.Target)invoker.TargTargLastHP = invoker.LineTarg.Target.Health;
			}
			Wait;
		
		
		//Nobody will like this one
		SecndHandCoolIdle666:
			#### # 0{
				if(Player.FindPSprite(MainLay))Player.SetPsprite(MainLay, invoker.FindState("MainHandWait"));
